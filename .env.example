# SQLite file (gitignored)
DB_PATH=spot.db
# Who the app opens "signed in" as (one of db.USERS' keys, e.g. daniel.okafor
# for the Payments Approver view). Does not change what that user can do -
# every role/team check in governance.py still applies. Blank = marcus.chen.
DEMO_DEFAULT_USER=
# LLM (openai Python client). Cloud is the default: set the key and model.
LLM_API_KEY=
# Optional; leave blank for the OpenAI default endpoint
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
# Optional local model. Set LLM_LOCAL=1 to use an OpenAI-compatible server
# such as Ollama, LM Studio, or llama.cpp. The API key can stay blank.
# Ollama default is below; LM Studio is usually http://localhost:1234/v1.
# LLM_LOCAL=1
# LLM_LOCAL_BASE_URL=http://localhost:11434/v1
# LLM_LOCAL_MODEL=llama3.2
